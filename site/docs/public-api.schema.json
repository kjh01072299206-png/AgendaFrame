{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agendaframe-capstone.kjh01072299206.chatgpt.site/schemas/public-api-v5.json",
  "title": "AgendaFrame public API",
  "description": "Public read API contract. Demo and live responses share this shape; runtimeMode identifies the source.",
  "x-api-version": "agendaframe-public-v5",
  "x-routes": {
    "chat": {"method": "POST", "path": "/api/chat", "grounding": "published_issue_comparison_only"},
    "community": {"list": "GET /api/issues/{issueId}/community", "create": "POST /api/issues/{issueId}/community", "report": "POST /api/comments/{commentId}/report"},
    "release": {"gate": "evals/thresholds.yaml", "promotion": "staging -> canary -> production"}
  },
  "oneOf": [
    { "$ref": "#/$defs/HealthResponse" },
    { "$ref": "#/$defs/ArticleListResponse" },
    { "$ref": "#/$defs/IssueDateListResponse" },
    { "$ref": "#/$defs/IssueListResponse" },
    { "$ref": "#/$defs/IssueDetailResponse" },
    { "$ref": "#/$defs/SourceListResponse" },
    { "$ref": "#/$defs/ErrorResponse" }
  ],
  "$defs": {
    "LineageMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "runtimeMode", "snapshotId", "runId", "basisDate", "publishedAt",
        "sourcePolicyVersion", "clusteringVersion", "scoreVersion", "frameTaxonomyVersion",
        "modelId", "promptVersion", "analysisSchemaVersion", "comparisonEngineVersion",
        "authorizationId", "approvalFingerprint", "clusterId", "reviewer", "approvalReviewedAt", "approvedUrlsSha256",
        "evaluationDatasetVersion"
      ],
      "properties": {
        "schemaVersion": { "const": "agendaframe-public-v5" },
        "runtimeMode": { "enum": ["demo", "live_metadata", "unavailable"] },
        "snapshotId": { "type": ["string", "null"] },
        "runId": { "type": ["string", "null"] },
        "basisDate": { "type": ["string", "null"], "format": "date" },
        "publishedAt": { "type": ["integer", "null"] },
        "sourcePolicyVersion": { "type": "string" },
        "clusteringVersion": { "type": "string" },
        "scoreVersion": { "type": "string" },
        "frameTaxonomyVersion": { "type": "string" },
        "modelId": { "type": "string" },
        "promptVersion": { "type": "string" },
        "analysisSchemaVersion": { "type": ["string", "null"] },
        "comparisonEngineVersion": { "type": ["string", "null"] },
        "authorizationId": { "type": ["string", "null"] },
        "approvalFingerprint": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "clusterId": { "type": ["string", "null"] },
        "reviewer": { "type": ["string", "null"] },
        "approvalReviewedAt": { "type": ["string", "null"], "format": "date-time" },
        "approvedUrlsSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "evaluationDatasetVersion": { "type": "string" }
      }
    },
    "ApprovalLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationId", "fingerprint", "clusterId", "reviewer", "reviewedAt", "approvedUrlsSha256"
      ],
      "properties": {
        "authorizationId": { "type": "string", "minLength": 1 },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "clusterId": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "approvedUrlsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "AnalysisLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId", "promptVersion", "analysisSchemaVersion", "comparisonEngineVersion", "approval"
      ],
      "properties": {
        "modelId": { "type": "string", "minLength": 1 },
        "promptVersion": { "type": "string", "minLength": 1 },
        "analysisSchemaVersion": { "type": "string", "minLength": 1 },
        "comparisonEngineVersion": { "type": "string", "minLength": 1 },
        "approval": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/ApprovalLineage" }
          ]
        }
      }
    },
    "Article": {
      "type": "object",
      "required": ["id", "source", "title", "url", "publishedAt"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "section": { "type": ["string", "null"] },
        "publishedAt": { "type": "integer" },
        "collectedAt": { "type": ["integer", "null"] },
        "homepagePlacement": { "type": ["string", "null"] },
        "homepageRank": { "type": ["integer", "null"] },
        "placementObservationCount": { "type": "integer", "minimum": 0 },
        "contentAvailable": { "enum": [true, false, 0, 1] },
        "representative": { "type": ["integer", "boolean"] },
        "similarity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": true
    },
    "Issue": {
      "type": "object",
      "required": [
        "id", "issueDate", "title", "summary", "category", "articleCount", "sourceCount",
        "agendaScore", "diversityScore", "placementScore", "volumeScore", "followUpVolumeScore",
        "placementObservedCount", "placementTotalCount", "scoreStatus", "calibrationStatus",
        "clusterQuality", "contentAvailableCount", "evidenceBasis"
      ],
      "properties": {
        "id": { "type": "string" },
        "issueDate": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "category": { "enum": ["정치", "경제", "사회", "국제", "스포츠", "생활·IT"] },
        "articleCount": { "type": "integer", "minimum": 1 },
        "sourceCount": { "type": "integer", "minimum": 1 },
        "agendaScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "diversityScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "placementScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "volumeScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "followUpVolumeScore": { "type": "number", "minimum": 0, "maximum": 100 },
        "placementObservedCount": { "type": "integer", "minimum": 0 },
        "placementTotalCount": { "type": "integer", "minimum": 0 },
        "scoreStatus": { "enum": ["legacy_reanalysis_required", "observed_components", "placement_excluded"] },
        "calibrationStatus": { "const": "not_calibrated" },
        "clusterQuality": { "enum": ["review_required", "not_human_reviewed", "cohesive", "insufficient_evidence"] },
        "contentAvailableCount": { "type": "integer", "minimum": 0 },
        "evidenceBasis": { "enum": ["headline_metadata_only", "body_signals_and_metadata", "structured_body_profiles_and_metadata", "authorized_body_and_metadata"] }
      },
      "additionalProperties": true
    },
    "Evidence": {
      "type": "object",
      "required": ["articleId", "sourceUrl", "text"],
      "properties": {
        "articleId": { "type": "string" },
        "source": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri" },
        "text": { "type": "string" },
        "evidenceType": { "enum": ["headline", "body_span"] }
      },
      "additionalProperties": false
    },
    "LegacyComparison": {
      "type": "object",
      "required": [
        "status", "evidenceBasis", "reason", "frameElements", "commonFacts", "divergenceQuestions",
        "sourceVoices", "recommendedPair", "availableHeadlineEvidence", "articleCount", "sourceCount"
      ],
      "properties": {
        "status": { "enum": ["withheld_insufficient_evidence", "available"] },
        "evidenceBasis": { "enum": ["headline_metadata_only", "body_signals_not_structured_comparison", "evidence_spans"] },
        "reason": { "type": "string" },
        "frameElements": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["element", "status", "evidence"],
            "properties": {
              "element": { "enum": ["problem_definition", "causal_attribution", "evaluation", "treatment_recommendation"] },
              "status": { "enum": ["not_assessed", "not_mentioned", "supported"] },
              "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } }
            },
            "additionalProperties": false
          }
        },
        "commonFacts": { "type": "array", "items": { "type": "object" } },
        "divergenceQuestions": { "type": "array", "items": { "type": "object" } },
        "sourceVoices": { "type": "array", "items": { "type": "object" } },
        "recommendedPair": { "type": ["object", "null"] },
        "availableHeadlineEvidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } },
        "articleCount": { "type": "integer", "minimum": 0 },
        "sourceCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "ClaimEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "articleId", "source", "sourceUrl", "evidenceLocator", "evidenceHash", "voiceKind"],
      "properties": {
        "claimId": { "type": "string", "minLength": 1 },
        "articleId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "evidenceLocator": { "type": ["string", "null"], "minLength": 1 },
        "evidenceHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "voiceKind": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "IssueMapAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "label", "frameFamily", "articleCount", "outletCount", "independentMediaGroups", "claimIds", "evidence"],
      "properties": {
        "groupId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "frameFamily": { "type": ["string", "null"] },
        "articleCount": { "type": "integer", "minimum": 2 },
        "outletCount": { "type": "integer", "minimum": 1 },
        "independentMediaGroups": { "type": "integer", "minimum": 1 },
        "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ClaimEvidence" } }
      }
    },
    "IssueMapSelectionBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumArticles", "minimumOutlets", "minimumIndependentMediaGroups", "minimumArticlesPerAnchor",
        "articleCount", "outletCount", "independentMediaGroups", "balancedCoverage", "overlap",
        "axisStrength", "coveredArticleCount", "formula"
      ],
      "properties": {
        "minimumArticles": { "type": "integer", "minimum": 0 },
        "minimumOutlets": { "type": "integer", "minimum": 0 },
        "minimumIndependentMediaGroups": { "type": "integer", "minimum": 0 },
        "minimumArticlesPerAnchor": { "type": "integer", "minimum": 0 },
        "articleCount": { "type": "integer", "minimum": 0 },
        "outletCount": { "type": "integer", "minimum": 0 },
        "independentMediaGroups": { "type": "integer", "minimum": 0 },
        "balancedCoverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "overlap": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "axisStrength": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "coveredArticleCount": { "type": "integer", "minimum": 0 },
        "formula": { "type": ["string", "null"] }
      }
    },
    "IssueMapOutlet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId", "source", "classification", "score", "displayPosition", "articleCount",
        "eligibleArticleCount", "leftArticleCount", "mixedArticleCount", "rightArticleCount",
        "evidenceStatus", "claimIds", "evidence"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["left", "mixed", "right", "insufficient"] },
        "score": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "displayPosition": { "type": ["number", "null"], "minimum": 10, "maximum": 90 },
        "articleCount": { "type": "integer", "minimum": 0 },
        "eligibleArticleCount": { "type": "integer", "minimum": 0 },
        "leftArticleCount": { "type": "integer", "minimum": 0 },
        "mixedArticleCount": { "type": "integer", "minimum": 0 },
        "rightArticleCount": { "type": "integer", "minimum": 0 },
        "evidenceStatus": { "enum": ["insufficient", "single_article_observation", "automatic_draft", "supported"] },
        "claimIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/ClaimEvidence" } }
      }
    },
    "IssueMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "axisId", "dimension", "label", "leftAnchor", "rightAnchor", "selectionBasis", "outlets"],
      "properties": {
        "status": { "enum": ["available", "provisional", "withheld_insufficient_evidence", "withheld_source_dominated", "withheld_review_required"] },
        "reason": { "type": "string", "minLength": 1 },
        "axisId": { "type": ["string", "null"] },
        "dimension": { "const": "problem_definition" },
        "label": { "type": "string", "minLength": 1 },
        "leftAnchor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/IssueMapAnchor" }] },
        "rightAnchor": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/IssueMapAnchor" }] },
        "selectionBasis": { "$ref": "#/$defs/IssueMapSelectionBasis" },
        "outlets": { "type": "array", "items": { "$ref": "#/$defs/IssueMapOutlet" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["available", "provisional"] } } },
          "then": {
            "properties": {
              "axisId": { "type": "string", "minLength": 1 },
              "leftAnchor": { "$ref": "#/$defs/IssueMapAnchor" },
              "rightAnchor": { "$ref": "#/$defs/IssueMapAnchor" }
            }
          },
          "else": {
            "properties": {
              "axisId": { "type": "null" },
              "leftAnchor": { "type": "null" },
              "rightAnchor": { "type": "null" },
              "outlets": { "type": "array", "maxItems": 0 }
            }
          }
        }
      ]
    },
    "NarrativeClause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "label", "groupId", "summary", "supportingArticleCount", "observedArticleCount", "supportShare", "claimIds", "evidence"],
      "properties": {
        "dimension": { "enum": ["problem_definition", "causal_interpretation", "responsibility_attribution", "moral_evaluation", "treatment_recommendation"] },
        "label": { "type": "string", "minLength": 1 },
        "groupId": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "supportingArticleCount": { "type": "integer", "minimum": 2 },
        "observedArticleCount": { "type": "integer", "minimum": 2 },
        "supportShare": { "type": "number", "minimum": 0.6, "maximum": 1 },
        "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ClaimEvidence" } }
      }
    },
    "Narrative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narrativeId", "status", "summary", "articleCount", "outletCount", "independentMediaGroups",
        "completeness", "supportingArticleIds", "supportingOutlets", "claimIds", "evidence",
        "problem", "cause", "responsibility", "evaluation", "remedy"
      ],
      "properties": {
        "narrativeId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["automatic_draft", "supported"] },
        "summary": { "type": "string", "minLength": 1 },
        "articleCount": { "type": "integer", "minimum": 2 },
        "outletCount": { "type": "integer", "minimum": 1 },
        "independentMediaGroups": { "type": "integer", "minimum": 1 },
        "completeness": { "type": "number", "minimum": 0.6, "maximum": 1 },
        "supportingArticleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "supportingOutlets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ClaimEvidence" } },
        "problem": { "$ref": "#/$defs/NarrativeClause" },
        "cause": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/NarrativeClause" }] },
        "responsibility": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/NarrativeClause" }] },
        "evaluation": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/NarrativeClause" }] },
        "remedy": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/NarrativeClause" }] }
      }
    },
    "ReaderQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "triggerType", "question", "basisClaimIds", "basisArticleIds", "evidence"],
      "properties": {
        "questionId": { "type": "string", "minLength": 1 },
        "triggerType": { "enum": ["narrative_contrast", "issue_axis_contrast", "affected_voice_gap", "source_voice_gap", "context_gap"] },
        "question": { "type": "string", "minLength": 1 },
        "basisClaimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "basisArticleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ClaimEvidence" } }
      }
    },
    "StructuredComparison": {
      "type": "object",
      "required": [
        "lineage", "status", "divergenceDetected", "evidenceBasis", "reason", "methodologyLabel", "reviewStatus",
        "summary", "sample", "axes", "issueMap", "narratives", "readerQuestions", "sourceLens", "contextGaps", "limitations"
      ],
      "properties": {
        "lineage": { "$ref": "#/$defs/AnalysisLineage" },
        "status": { "enum": ["available", "partial", "withheld_insufficient_evidence"] },
        "divergenceDetected": { "type": "boolean" },
        "evidenceBasis": { "enum": ["headline_metadata_only", "evidence_spans"] },
        "reason": { "type": "string" },
        "methodologyLabel": { "type": "string" },
        "reviewStatus": {
          "enum": [
            "automatic_draft",
            "cluster_review_required",
            "human_reviewed",
            "rejected"
          ]
        },
        "summary": {
          "type": "object",
          "required": ["commonGround", "mainDifference", "whyItMatters", "sourceContext"],
          "properties": {
            "commonGround": { "type": ["string", "null"] },
            "mainDifference": { "type": ["string", "null"] },
            "whyItMatters": { "type": ["string", "null"] },
            "sourceContext": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "sample": {
          "type": "object",
          "required": ["analyzedArticles", "textScope", "outlets", "independentMediaGroups", "excludedArticles", "inputTruncatedArticles"],
          "properties": {
            "analyzedArticles": { "type": "integer", "minimum": 0 },
            "textScope": { "enum": ["provider_excerpt", "article_body"] },
            "outlets": { "type": "integer", "minimum": 0 },
            "independentMediaGroups": { "type": "integer", "minimum": 0 },
            "excludedArticles": { "type": "integer", "minimum": 0 },
            "inputTruncatedArticles": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "axes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "label", "variants"],
            "properties": {
              "dimension": { "enum": ["problem_definition", "causal_interpretation", "responsibility_attribution", "moral_evaluation", "treatment_recommendation"] },
              "label": { "type": "string", "minLength": 1 },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["groupId", "frameFamily", "claimIds", "summary", "outlets", "commitment", "status", "evidenceLocator", "basis"],
                  "properties": {
                    "groupId": { "type": "string", "minLength": 1 },
                    "frameFamily": { "type": ["string", "null"] },
                    "claimIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
                    "summary": { "type": "string", "minLength": 1 },
                    "outlets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["source", "articleId", "sourceUrl", "claimId", "evidenceLocator", "evidenceHash", "voiceKind"],
                        "properties": {
                          "source": { "type": "string", "minLength": 1 },
                          "articleId": { "type": "string", "minLength": 1 },
                          "sourceUrl": { "type": "string", "format": "uri" },
                          "claimId": { "type": "string", "minLength": 1 },
                          "evidenceLocator": { "type": ["string", "null"] },
                          "evidenceHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
                          "voiceKind": { "type": ["string", "null"] }
                        },
                        "additionalProperties": false
                      }
                    },
                    "commitment": { "enum": ["explicit", "source_attributed"] },
                    "status": { "enum": ["supported", "attributed_source"] },
                    "evidenceLocator": { "type": ["string", "null"] },
                    "basis": { "type": ["string", "null"] }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "issueMap": { "$ref": "#/$defs/IssueMap" },
        "narratives": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/Narrative" } },
        "readerQuestions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/ReaderQuestion" } },
        "sourceLens": {
          "type": "object",
          "required": ["sharedVoices", "voicesPresentInSomeOutlets", "byOutlet", "caution"],
          "properties": {
            "sharedVoices": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "voicesPresentInSomeOutlets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "byOutlet": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "source", "articleCount", "sourceArticleCount", "voices", "roleCounts",
                  "officialShare", "affectedGroupVoice", "affectedGroupPresenceRate"
                ],
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "articleCount": { "type": "integer", "minimum": 0 },
                  "sourceArticleCount": { "type": "integer", "minimum": 0 },
                  "voices": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                  "roleCounts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "role", "roleLabel", "count", "articleCount", "presenceRate",
                        "directQuoteArticleCount", "indirectAttributionArticleCount", "mentionCount"
                      ],
                      "properties": {
                        "role": { "type": "string", "minLength": 1 },
                        "roleLabel": { "type": "string", "minLength": 1 },
                        "count": { "type": "integer", "minimum": 1 },
                        "articleCount": { "type": "integer", "minimum": 1 },
                        "presenceRate": { "type": "number", "minimum": 0, "maximum": 1 },
                        "directQuoteArticleCount": { "type": "integer", "minimum": 0 },
                        "indirectAttributionArticleCount": { "type": "integer", "minimum": 0 },
                        "mentionCount": { "type": "integer", "minimum": 0 }
                      },
                      "additionalProperties": false
                    }
                  },
                  "officialShare": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                  "affectedGroupVoice": { "type": "boolean" },
                  "affectedGroupPresenceRate": { "type": "number", "minimum": 0, "maximum": 1 }
                },
                "additionalProperties": false
              }
            },
            "caution": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "contextGaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature", "presentInOutlets", "notObservedInOutlets", "displayText"],
            "properties": {
              "feature": { "type": "string" },
              "presentInOutlets": { "type": "array", "items": { "type": "string" } },
              "notObservedInOutlets": { "type": "array", "items": { "type": "string" } },
              "displayText": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "analysisModules": { "$ref": "#/$defs/AnalysisModules" }
      },
      "additionalProperties": false
    },
    "Comparison": {
      "oneOf": [
        { "$ref": "#/$defs/LegacyComparison" },
        { "$ref": "#/$defs/StructuredComparison" }
      ]
    },
    "HealthResponse": {
      "type": "object",
      "required": ["status", "mode", "dataAsOf", "collection", "freshness", "timestamps", "meta"],
      "properties": {
        "status": { "enum": ["ok", "degraded", "error"] },
        "mode": { "enum": ["demo", "live_metadata", "unavailable"] },
        "dataAsOf": { "type": ["string", "null"] },
        "collection": { "type": "object" },
        "analysis": { "type": ["object", "null"] },
        "freshness": { "type": "object" },
        "timestamps": { "type": "object" },
        "meta": { "$ref": "#/$defs/LineageMeta" }
      },
      "additionalProperties": true
    },
    "ArticleListResponse": {
      "type": "object",
      "required": ["articles", "total", "limit", "offset", "hasMore", "nextCursor", "meta"],
      "properties": {
        "articles": { "type": "array", "items": { "$ref": "#/$defs/Article" } },
        "total": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "hasMore": { "type": "boolean" },
        "nextCursor": { "type": ["string", "null"] },
        "meta": { "$ref": "#/$defs/LineageMeta" }
      },
      "additionalProperties": false
    },
    "IssueListResponse": {
      "type": "object",
      "required": ["issues", "total", "categories", "meta"],
      "properties": {
        "issues": { "type": "array", "items": { "$ref": "#/$defs/Issue" } },
        "total": { "type": "integer", "minimum": 0 },
        "categories": { "type": "array", "items": { "type": "object" } },
        "meta": { "$ref": "#/$defs/LineageMeta" }
      },
      "additionalProperties": true
    },
    "IssueDateListResponse": {
      "type": "object",
      "required": ["dates", "meta"],
      "properties": {
        "dates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["date", "analyzedAt", "articleCount", "issueCount"],
            "properties": {
              "date": { "type": "string", "format": "date" },
              "analyzedAt": { "type": ["integer", "null"] },
              "articleCount": { "type": "integer", "minimum": 0 },
              "issueCount": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "meta": { "$ref": "#/$defs/LineageMeta" }
      },
      "additionalProperties": false
    },
    "IssueDetailResponse": {
      "type": "object",
      "required": ["issue", "articles", "frames", "report", "outlets", "comparison", "meta"],
      "properties": {
        "issue": { "$ref": "#/$defs/Issue" },
        "articles": { "type": "array", "items": { "$ref": "#/$defs/Article" } },
        "frames": { "type": "array", "items": { "type": "object" } },
        "report": { "type": ["object", "null"] },
        "outlets": { "type": "array", "items": { "type": "object" } },
        "comparison": { "$ref": "#/$defs/Comparison" },
        "meta": { "$ref": "#/$defs/LineageMeta" }
      },
      "additionalProperties": false
    },
    "SourceListResponse": {
      "type": "object",
      "required": ["sources", "meta"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "object" } },
        "meta": { "$ref": "#/$defs/LineageMeta" }
      },
      "additionalProperties": true
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["error", "requestId"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
          "additionalProperties": false
        },
        "requestId": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
