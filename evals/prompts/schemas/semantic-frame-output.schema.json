{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["decision", "dimensions", "prompt_version", "schema_version"],
  "properties": {
    "decision": {
      "enum": ["analyze", "review_needed", "defer"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "dimension",
          "status",
          "value",
          "voice_kind",
          "evidence",
          "reason"
        ],
        "properties": {
          "dimension": {
            "enum": [
              "problem_definition",
              "causal_attribution",
              "responsibility_attribution",
              "evaluation",
              "treatment_recommendation",
              "actor_visibility"
            ]
          },
          "status": {
            "enum": ["supported", "conflicting", "explicit_not_stated"]
          },
          "value": {
            "type": ["string", "null"]
          },
          "voice_kind": {
            "type": ["string", "null"],
            "enum": [
              "journalist_narration",
              "direct_quote",
              "indirect_source",
              "uncertain_quote",
              null
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["article_id", "start", "end", "text"],
              "properties": {
                "article_id": {"type": "string"},
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 1},
                "text": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "reason": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "prompt_version": {"const": "2.0.0"},
    "schema_version": {"const": 2}
  },
  "additionalProperties": false
}
