{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["prompt_version", "schema_version", "event_paragraphs", "terms", "comparison_axis", "common_ground", "camps"],
  "properties": {
    "prompt_version": { "const": "event-synthesis-v2.0.0" },
    "schema_version": { "const": "agendaframe.event-synthesis.v2" },
    "event_paragraphs": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/claim" } },
    "terms": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/term" } },
    "comparison_axis": {
      "type": ["object", "null"],
      "required": ["label", "points", "question", "evidence"],
      "properties": {
        "label": { "type": "string", "maxLength": 120 },
        "points": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/claim" } },
        "question": { "type": "string", "maxLength": 320 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "common_ground": { "$ref": "#/$defs/claim" },
    "camps": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/camp" } }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["article_id", "locator", "sentence_sha256"],
      "properties": {
        "article_id": { "type": "string" },
        "locator": { "type": "object", "required": ["paragraph", "sentence"], "properties": { "paragraph": { "type": "integer" }, "sentence": { "type": "integer" } }, "additionalProperties": false },
        "sentence_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["text", "evidence"],
      "properties": { "text": { "type": "string", "maxLength": 720 }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } } },
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "required": ["term", "gloss", "evidence"],
      "properties": { "term": { "type": "string", "maxLength": 60 }, "gloss": { "type": "string", "maxLength": 360 }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } } },
      "additionalProperties": false
    },
    "voice_basis": {
      "type": "object",
      "required": ["kind", "label", "evidence"],
      "properties": { "kind": { "type": "string" }, "label": { "type": "string" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } } },
      "additionalProperties": false
    },
    "proof_row": {
      "type": "object",
      "required": ["article_id", "dimension", "public_paraphrase", "evidence"],
      "properties": { "article_id": { "type": "string" }, "outlet": { "type": "string" }, "dimension": { "type": "string" }, "public_paraphrase": { "type": "string", "maxLength": 420 }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } } },
      "additionalProperties": false
    },
    "camp": {
      "type": "object",
      "required": ["name", "headline", "summary", "decisive_difference", "outlets", "article_ids", "voice_basis", "evidence", "proof_rows"],
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "headline": { "type": "string", "maxLength": 180 },
        "summary": { "type": "string", "maxLength": 720 },
        "decisive_difference": { "type": "string", "maxLength": 420 },
        "outlets": { "type": "array", "items": { "type": "string" } },
        "article_ids": { "type": "array", "items": { "type": "string" } },
        "voice_basis": { "$ref": "#/$defs/voice_basis" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "headline_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "summary_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "decisive_difference_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "proof_rows": { "type": "array", "items": { "$ref": "#/$defs/proof_row" } }
      },
      "additionalProperties": false
    }
  }
}
