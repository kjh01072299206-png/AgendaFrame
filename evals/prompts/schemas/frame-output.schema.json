{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agendaframe.example.invalid/schemas/frame-output-v1.json",
  "type": "object",
  "required": ["decision", "labels", "prompt_version", "taxonomy_version", "schema_version"],
  "properties": {
    "decision": {"enum": ["analyze", "review_needed", "defer"]},
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "evidence"],
        "properties": {
          "label": {"enum": ["conflict", "responsibility", "economic", "legal_institutional", "policy_effect", "citizen_impact"]},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["start", "end", "text"],
              "properties": {
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 1},
                "text": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "prompt_version": {"const": "1.0.0"},
    "taxonomy_version": {"const": "frames-ko-v1.0.0"},
    "schema_version": {"const": 1}
  },
  "additionalProperties": false
}
