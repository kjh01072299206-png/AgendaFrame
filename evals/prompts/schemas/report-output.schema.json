{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agendaframe.example.invalid/schemas/report-output-v1.json",
  "type": "object",
  "required": ["decision", "sections", "claims", "caveats", "prompt_version", "schema_version"],
  "properties": {
    "decision": {"enum": ["generate", "defer"]},
    "sections": {"type": "object"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "support_ids"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "support_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "caveats": {"type": "array", "items": {"type": "string"}},
    "prompt_version": {"const": "1.0.0"},
    "schema_version": {"const": 1}
  },
  "additionalProperties": false
}
